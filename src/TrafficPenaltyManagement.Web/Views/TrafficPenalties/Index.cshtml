@using TrafficPenaltyManagement.Domain.Enums
@model List<TrafficPenaltyManagement.Application.DTOs.TrafficPenaltiesDtos.TrafficPenaltyDto>

@{
    ViewData["Title"] = "Trafik Cezaları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Trafik Cezaları</h2>

    @if (User.IsInRole("Employee") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            Yeni Ceza Ekle
        </a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Henüz kayıtlı trafik cezası bulunmuyor.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Ceza No</th>
                    <th>Araç Plakası</th>
                    <th>Ceza Tarihi</th>
                    <th>Açıklama</th>
                    <th>Tutar</th>
                    <th>Kaydı Oluşturan</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var penalty in Model)
                {
                    <tr>
                        <td>@penalty.PenaltyNumber</td>
                        <td>@penalty.VehiclePlate</td>
                        <td>@penalty.PenaltyDate.ToString("dd.MM.yyyy")</td>
                        <td>@penalty.Description</td>
                        <td>@penalty.Amount.ToString("N2") TL</td>
                        <td>@penalty.CreatedByFullName</td>
                        <td>
                            @switch (penalty.CurrentStatus)
                            {
                                case PenaltyStatus.New:
                                    <span class="badge bg-secondary">Yeni</span>
                                    break;

                                case PenaltyStatus.WaitingForManagerApproval:
                                    <span class="badge bg-warning text-dark">
                                        Yönetici Onayı Bekliyor
                                    </span>
                                    break;

                                case PenaltyStatus.WaitingForFinanceApproval:
                                    <span class="badge bg-info text-dark">
                                        Finans Onayı Bekliyor
                                    </span>
                                    break;

                                case PenaltyStatus.Completed:
                                    <span class="badge bg-success">Tamamlandı</span>
                                    break;

                                case PenaltyStatus.Rejected:
                                    <span class="badge bg-danger">Reddedildi</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-controller="TrafficPenalties"
                               asp-action="Details"
                               asp-route-id="@penalty.Id"
                               class="btn btn-sm btn-outline-primary">
                                Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
