@model List<TrafficPenaltyManagement.Application.DTOs.TrafficPenaltiesDtos.TrafficPenaltyDto>

@{
    ViewData["Title"] = "Yönetici Onayları";
}

<h2 class="mb-4">Yönetici Onayları</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Yönetici onayı bekleyen trafik cezası bulunmuyor.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Ceza No</th>
                    <th>Plaka</th>
                    <th>Tarih</th>
                    <th>Tutar</th>
                    <th>Açıklama</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var penalty in Model)
                {
                    <tr>
                        <td>@penalty.PenaltyNumber</td>
                        <td>@penalty.VehiclePlate</td>
                        <td>@penalty.PenaltyDate.ToString("dd.MM.yyyy")</td>
                        <td>@penalty.Amount.ToString("N2") TL</td>
                        <td>@penalty.Description</td>
                        <td>
                            <div class="d-flex flex-column gap-2">
                                <a asp-action="Details"
                                   asp-route-id="@penalty.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Detay
                                </a>

                                <form asp-action="Approve"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden"
                                           name="id"
                                           value="@penalty.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-success w-100">
                                        Onayla
                                    </button>
                                </form>

                                <form asp-action="Reject"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden"
                                           name="id"
                                           value="@penalty.Id" />

                                    <textarea name="reason"
                                      class="form-control form-control-sm mb-2"
                                      maxlength="1000"
                                      required
                                      placeholder="Ret gerekçesini yazınız"></textarea>

                                    <button type="submit"
                                            class="btn btn-sm btn-danger w-100">
                                        Reddet
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
