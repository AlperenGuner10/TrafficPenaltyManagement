@model TrafficPenaltyManagement.Application.DTOs.TrafficPenaltiesDtos.UpdateTrafficPenaltyDto

@{
    ViewData["Title"] = "Reddedilen Cezayı Düzenle";
}

<h2>Reddedilen Trafik Cezasını Düzenle</h2>

<form asp-action="Update" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="VehicleId" class="form-label">Araç</label>
        <select asp-for="VehicleId"
                asp-items="ViewBag.ActiveVehicles"
                class="form-select">
            <option value="">Araç seçiniz</option>
        </select>
        <span asp-validation-for="VehicleId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PenaltyDate" class="form-label">Ceza Tarihi</label>
        <input asp-for="PenaltyDate" type="date" class="form-control" />
        <span asp-validation-for="PenaltyDate"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Açıklama</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Ceza Tutarı</label>
        <input asp-for="Amount" class="form-control" type="number"
               min="0.01" step="0.01" />
        <span asp-validation-for="Amount"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Değişiklikleri Kaydet
    </button>

    <a asp-action="Details" asp-route-id="@Model.Id"
       class="btn btn-secondary">
        İptal
    </a>
</form>