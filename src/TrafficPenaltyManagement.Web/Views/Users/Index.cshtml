@model List<TrafficPenaltyManagement.Web.ViewModels.UserRoleViewModel>

@{
	ViewData["Title"] = "Kullanıcı Yönetimi";
	var roles = (string[])ViewBag.AllowedRoles;
}

<h2 class="mb-4">Kullanıcı ve Rol Yönetimi</h2>

<div class="alert alert-info">
	Her kullanıcıya bu ekrandan tek bir uygulama rolü atanır.
</div>

<div class="table-responsive">
	<table class="table table-striped align-middle">
		<thead>
			<tr>
				<th>Ad Soyad</th>
				<th>E-posta</th>
				<th>Mevcut Rol</th>
				<th>Yeni Rol</th>
			</tr>
		</thead>

		<tbody>
			@foreach (var user in Model)
			{
				<tr>
					<td>@user.FullName</td>
					<td>@user.Email</td>
					<td>@user.CurrentRole</td>
					<td>
						<form asp-action="AssignRole"
							  method="post"
							  class="d-flex gap-3 align-items-center">

							@Html.AntiForgeryToken()

							<input type="hidden"
								   name="userId"
								   value="@user.UserId" />

							<select name="selectedRole"
									class="form-select"
									required>

								@foreach (var role in roles)
								{
									<option value="@role"
											selected="@(role == user.SelectedRole)">
										@role
									</option>
								}

							</select>

							<button type="submit"
									class="btn btn-primary btn-sm">
								Ata
							</button>

						</form>
					</td>
				</tr>
			}
		</tbody>

	</table>
</div>
