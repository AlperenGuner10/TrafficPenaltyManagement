@model List<TrafficPenaltyManagement.Application.DTOs.VehicleDto>
@using TrafficPenaltyManagement.Domain.Enums

@{
    ViewData["Title"] = "Araç Listesi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Araç Listesi</h2>

        <a asp-controller="Vehicles"
           asp-action="Create"
           class="btn btn-success">
            Araç Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success">
            @message
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Henüz kayıtlı araç bulunmuyor.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Plaka</th>
                        <th>Araç Türü</th>
                        <th>Marka</th>
                        <th>Model</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehicle in Model)
                    {
                        <tr>
                            <td>@vehicle.Plate</td>
                            <td>
                                @(vehicle.VehicleType switch
                                {
                                    VehicleType.PassengerCar => "Binek",
                                    VehicleType.TruckTractor => "Çekici",
                                    VehicleType.Trailer => "Dorse",
                                    VehicleType.RentalVehicle => "Kiralık Araç",
                                    _ => "Bilinmiyor"
                                })
                    </td>
                    <td>@vehicle.Brand</td>
                    <td>@vehicle.Model</td>
                    <td>
                        @if (vehicle.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>

                            <td>
                                <a asp-controller="Vehicles"
                                   asp-action="Details"
                                   asp-route-id="@vehicle.VehicleDtoId"
                                   class="btn btn-sm btn-primary">
                                    Detay
                                </a>

                                @if (vehicle.IsActive)
                                {
                                    <a asp-controller="Vehicles"
                                       asp-action="Update"
                                       asp-route-id="@vehicle.VehicleDtoId"
                                       class="btn btn-sm btn-warning">
                                        Düzenle
                                    </a>

                                    <form asp-controller="Vehicles"
                                          asp-action="Deactivate"
                                          asp-route-id="@vehicle.VehicleDtoId"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bu aracı pasife almak istediğinize emin misiniz?');">

                                        <button type="submit" class="btn btn-sm btn-danger">
                                            Pasife Al
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
